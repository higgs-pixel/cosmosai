# Server-only. Optional; required only for live NASA Open API data beyond public fallback content.
# Do not prefix this with NEXT_PUBLIC_.
NASA_API_KEY=your_nasa_api_key_here

# Server-only. Optional primary Ask COSMOS provider; static guidance remains available without it.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Server-only. Optional fallback provider for live AI responses when Groq is unavailable.
# Do not prefix this with NEXT_PUBLIC_.
OPENAI_API_KEY=your_openai_api_key_here

# Server-only. Optional. Defaults to gpt-5-mini when omitted, then falls back to gpt-4o-mini if GPT-5 is unavailable.
OPENAI_MODEL=gpt-5-mini

# Server-only. Optional, but recommended for OpenAlex API quota and production research search.
# Do not prefix this with NEXT_PUBLIC_.
OPENALEX_API_KEY=your_openalex_api_key_here
OPENALEX_EMAIL=your_email@example.com

# Server-only optional external intelligence sources. Their features degrade gracefully when omitted.
CORE_API_KEY=your_core_api_key_here
WEATHERSTACK_API_KEY=your_weatherstack_api_key_here
PURPLEAIR_API_KEY=your_purpleair_api_key_here

# Server-read public Vercel Blob/CDN URLs for Aryan's approved cinematic homepage videos.
# These values are passed to the homepage as public media URLs; they are not secrets.
# Keep WebM first for efficient playback and MP4 as the broad-compatibility fallback.
COSMOS_HOME_BLACKHOLE_WEBM_URL=https://67j4ob8jer25jd6r.public.blob.vercel-storage.com/blackhole.webm
COSMOS_HOME_BLACKHOLE_MP4_URL=https://67j4ob8jer25jd6r.public.blob.vercel-storage.com/Blackhole.mp4
COSMOS_HOME_SUN_WEBM_URL=https://67j4ob8jer25jd6r.public.blob.vercel-storage.com/Sun.webm
COSMOS_HOME_SUN_MP4_URL=https://67j4ob8jer25jd6r.public.blob.vercel-storage.com/Sun.mp4
COSMOS_HOME_SKY_WEBM_URL=https://67j4ob8jer25jd6r.public.blob.vercel-storage.com/Sky.webm
COSMOS_HOME_SKY_MP4_URL=https://67j4ob8jer25jd6r.public.blob.vercel-storage.com/Sky.mp4

# Server-read public/free API base URLs. Optional; override only if a provider changes endpoint.
SEVENTIMER_BASE_URL=https://www.7timer.info
ARCSECOND_BASE_URL=https://api.arcsecond.io
OPEN_METEO_BASE_URL=https://api.open-meteo.com
ISRO_API_BASE_URL=https://isro.vercel.app
USGS_EARTHQUAKE_BASE_URL=https://earthquake.usgs.gov
SUNRISE_SUNSET_BASE_URL=https://api.sunrise-sunset.org
WORLD_BANK_BASE_URL=https://api.worldbank.org
ARXIV_BASE_URL=https://export.arxiv.org
WIKIDATA_API_BASE_URL=https://www.wikidata.org/w/api.php

# Browser-safe canonical site URL. Required in production outside Vercel; Vercel host variables are accepted.
# Use http://localhost:3000 locally and an https URL for production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Browser-safe optional Supabase project values. Configure both together to enable authentication.
# Never add Supabase service-role keys to frontend or .env.example files.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Optional locally; required by production policy when a paid AI provider is enabled.
# Create an Upstash Redis database and use its REST credentials for distributed abuse protection.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Server-only random value used to pseudonymise actors in security logs.
SECURITY_LOG_SALT=

# Server-only integer in milliseconds. Optional; range 100-30000, default 6000.
SERVER_FETCH_TIMEOUT_MS=6000
